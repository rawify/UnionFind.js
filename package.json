{
    "name": "@rawify/unionfind",
    "version": "0.0.2",
    "type": "commonjs",
    "description": "Disjoint-set union for integer IDs with union by size, path halving, component sizes, and reset",
    "homepage": "https://github.com/rawify/UnionFind.js",
    "bugs": "https://github.com/rawify/UnionFind.js/issues",
    "keywords": [
        "union-find",
        "unionfind",
        "disjoint-set",
        "disjoint set union",
        "graph algorithms",
        "path compression",
        "data structure",
        "algorithms"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "main": "./dist/unionfind.js",
    "module": "./dist/unionfind.mjs",
    "unpkg": "./dist/unionfind.min.js",
    "jsdelivr": "./dist/unionfind.min.js",
    "types": "./dist/unionfind.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/unionfind.d.mts",
                "default": "./dist/unionfind.mjs"
            },
            "require": {
                "types": "./dist/unionfind.d.ts",
                "default": "./dist/unionfind.js"
            },
            "default": {
                "types": "./dist/unionfind.d.ts",
                "default": "./dist/unionfind.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/rawify/UnionFind.js.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/rawify"
    },
    "author": {
        "name": "Robert Eisele",
        "email": "robert@raw.org",
        "url": "https://raw.org/"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "clean": "node scripts/clean.mjs",
        "typecheck": "tsc --noEmit",
        "build:types": "tsc -p tsconfig.build.json",
        "build:js": "node scripts/build.mjs",
        "build": "npm run clean && npm run build:types && npm run build:js",
        "test:types": "tsc -p tests/types/tsconfig.json",
        "test:runtime": "node --test tests/*.test.js tests/*.test.mjs",
        "test": "npm run build && npm run test:types && npm run test:runtime",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "esbuild": "^0.25.9",
        "typescript": "^5.9.2"
    }
}