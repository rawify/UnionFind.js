    "engines": {
        "node": "*"
    },
    "directories": {
        "test": "tests"
    },
    "scripts": {
        "test": "mocha tests/*",
        "build": "crude-build UnionFind"
    },
    "devDependencies": {
        "chai": "^5.2.1",
        "crude-build": "^0.1.0",
        "mocha": "^11.7.1"
